APP_NAME=MoneyFlex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL runs as a container (service name "mysql").
# From the host it is published on ${DB_HOST_PORT} to avoid clashing with a local MySQL on 3306.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=moneyflex
DB_USERNAME=root
DB_PASSWORD=root_123
DB_HOST_PORT=3307

# Seeded API account. Every endpoint accepts these as Basic Auth credentials,
# and POST /api/v1/auth/login exchanges them for a bearer token.
API_USER_EMAIL=api@moneyflex.test
API_USER_PASSWORD=password123

# JWT. Leave JWT_SECRET empty to fall back to APP_KEY; set it in production so
# rotating it does not invalidate everything else APP_KEY protects.
JWT_SECRET=
JWT_ALGORITHM=HS256
# Access token lifetime in minutes, then how long refreshing stays possible.
JWT_TTL=60
JWT_REFRESH_TTL=20160

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Redis backs the cache (see phase 5).
CACHE_STORE=redis
CACHE_PREFIX=moneyflex
CACHE_TTL=300

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@moneyflex.test"
MAIL_FROM_NAME="${APP_NAME}"

# Ports published on the host by docker compose.
APP_HOST_PORT=8080
