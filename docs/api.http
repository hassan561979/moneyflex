### MoneyFlex API
### Runnable from VS Code (REST Client) or JetBrains HTTP Client.
### Authentication arrives in phase 4; these requests are open for now.

@base = http://localhost:8080/api/v1
@customerId = 1
@serviceId = 1

### Health
GET {{base}}/health
Accept: application/json

###############################################################################
# Customers
###############################################################################

### List customers
GET {{base}}/customers
Accept: application/json

### List customers, filtered, sorted and paginated
# sort accepts: id, name, email, status, created_at, updated_at
# prefix with "-" for descending
GET {{base}}/customers?search=acme&status=active&sort=-created_at&per_page=10&page=1
Accept: application/json

### Create a customer
POST {{base}}/customers
Content-Type: application/json
Accept: application/json

{
  "name": "Acme Holdings",
  "email": "new.customer@moneyflex.test",
  "phone": "+971500000009",
  "address": "1 Sheikh Zayed Road, Dubai",
  "status": "active"
}

### View a customer
GET {{base}}/customers/{{customerId}}
Accept: application/json

### Update a customer (partial update; send only what changes)
PATCH {{base}}/customers/{{customerId}}
Content-Type: application/json
Accept: application/json

{
  "status": "inactive"
}

### Delete a customer (soft delete; also hides their services)
DELETE {{base}}/customers/{{customerId}}
Accept: application/json

###############################################################################
# Services
###############################################################################

### List every service
# sort accepts: id, name, price, status, starts_at, ends_at, created_at, updated_at
GET {{base}}/services?status=active&sort=-price&per_page=10
Accept: application/json

### List the services of one customer
GET {{base}}/customers/{{customerId}}/services
Accept: application/json

### Create a service for a customer
# The owner comes from the URL; a customer_id in the body is ignored.
POST {{base}}/customers/{{customerId}}/services
Content-Type: application/json
Accept: application/json

{
  "name": "Payment Gateway",
  "description": "Card acquiring and settlement",
  "price": "249.99",
  "status": "active",
  "starts_at": "2026-01-01",
  "ends_at": "2027-01-01"
}

### View a service
GET {{base}}/services/{{serviceId}}
Accept: application/json

### Update a service
PATCH {{base}}/services/{{serviceId}}
Content-Type: application/json
Accept: application/json

{
  "price": "299.00",
  "status": "suspended"
}

### Delete a service
DELETE {{base}}/services/{{serviceId}}
Accept: application/json

###############################################################################
# Error responses
###############################################################################

### 422 validation error
POST {{base}}/customers
Content-Type: application/json
Accept: application/json

{}

### 404 not found
GET {{base}}/customers/999999
Accept: application/json
